### Alertes critiques à configurer

```yaml
# prometheus-alerts.yml
groups:
  - name: rabbitmq
    interval: 30s
    rules:
      - alert: RabbitMQMemoryHigh
        expr: rabbitmq_node_mem_used / rabbitmq_node_mem_limit > 0.8
        for: 2m
        annotations:
          summary: "RabbitMQ memory usage > 80%"
      
      - alert: RabbitMQQueueGrowing
        expr: rate(rabbitmq_queue_messages[5m]) > 100
        for: 5m
        annotations:
          summary: "Queue growing rapidly"
      
      - alert: RabbitMQDiskLow
        expr: rabbitmq_node_disk_free < 10737418240  # 10GB
        annotations:
          summary: "Disk space < 10GB"
      
      - alert: RabbitMQConsumerDown
        expr: rabbitmq_queue_consumers{queue="event"} == 0
        for: 1m
        annotations:
          summary: "No consumers on event queue!"
```

