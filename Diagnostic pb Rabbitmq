## 1. Diagnostic approfondi de la saturation mémoire

### Comprendre le comportement de RabbitMQ avec la mémoire

```bash
# Script de monitoring à exécuter AVANT le prochain crash
cat > /tmp/rabbitmq_monitor.sh << 'EOF'
#!/bin/bash
LOG_FILE="/var/log/rabbitmq_custom_monitor.log"

while true; do
    echo "=== $(date) ===" >> $LOG_FILE
    
    # Mémoire totale du node
    rabbitmqctl status | grep -A 15 "Memory" >> $LOG_FILE
    
    # Top 10 queues par consommation mémoire
    echo "Top queues by memory:" >> $LOG_FILE
    rabbitmqctl list_queues name messages messages_ready messages_unacknowledged \
        memory consumers state --formatter json | \
        jq -r '.[] | "\(.memory)\t\(.name)\t\(.messages)"' | \
        sort -rn | head -10 >> $LOG_FILE
    
    # Connexions actives
    echo "Active connections: $(rabbitmqctl list_connections | wc -l)" >> $LOG_FILE
    
    # Channels actifs
    echo "Active channels: $(rabbitmqctl list_channels | wc -l)" >> $LOG_FILE
    
    # Erlang processes
    PROC_COUNT=$(rabbitmqctl eval 'erlang:system_info(process_count).')
    PROC_LIMIT=$(rabbitmqctl eval 'erlang:system_info(process_limit).')
    echo "Erlang processes: $PROC_COUNT / $PROC_LIMIT" >> $LOG_FILE
    
    # Disk space
    echo "Disk usage:" >> $LOG_FILE
    df -h /var/lib/rabbitmq >> $LOG_FILE
    
    # Alarms
    ALARMS=$(rabbitmqctl alarm_list)
    echo "Alarms: $ALARMS" >> $LOG_FILE
    
    echo "---" >> $LOG_FILE
    
    sleep 30
done
EOF

chmod +x /tmp/rabbitmq_monitor.sh
nohup /tmp/rabbitmq_monitor.sh &
```

